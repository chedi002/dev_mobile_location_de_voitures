{
  "name": "wijha-api",
  "version": "1.0.0",
  "description": "API Express de WIJHA : catalogue, réservations, messages et administration",
  "private": true,
  "type": "module",
  "main": "src/serveur.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/serveur.js",
    "dev": "node --watch --env-file-if-exists=.env src/serveur.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jose": "6.2.14",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1",
    "vitest": "4.1.12"
  }
}

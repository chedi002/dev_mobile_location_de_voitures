# Copiez ce fichier en .env puis remplissez les valeurs. Le fichier .env n'est jamais versionné.

# Chaîne de connexion PostgreSQL (obligatoire)
# Supabase > bouton « Connect » (en haut) > onglet « Connection string » > « Session pooler »,
# puis remplacez [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Projet Supabase (sert à vérifier les jetons de connexion, sans secret)
SUPABASE_URL=https://acmgjilyytsstgxjcetb.supabase.co

# Port de l'API et adresse du site autorisée à l'appeler
PORT=3000
CORS_ORIGIN=http://localhost:4200

# E-mails (facultatif). Sans SMTP_HOST, les e-mails sont affichés dans le terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WIJHA <no-reply@wijha.tn>
# Adresse de l'agence qui reçoit les nouvelles demandes
AGENCY_EMAIL=
